    <icon guid="d2c12ed9-9585-4f85-9662-fb0ff32d9bbb" name="d2c12ed9-9585-4f85-9662-fb0ff32d9bbb.svg">
      <light><svg width="48" height="48" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0pt 0pt 48pt 48pt" fill-dark="#FFF" stroke-dark="none">
  <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 48 48">
    <!-- 1. SURFACES -->
    <!-- Reference Surface (Left) -->
    <path d="M 22,8 L 4,14 L 4,28 L 22,22 Z" fill="#E0E0E0" fill-dark="#4D4D4D" stroke="#000000" stroke-dark="#FFFFFF" stroke-width="2" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" />
    <!-- Target Surface (Right) -->
    <path d="M 22,8 C 30,8 38,4 44,4 L 44,18 C 38,18 30,22 22,22 Z" fill="#FFFFFF" fill-dark="#333333" stroke="#000000" stroke-dark="#FFFFFF" stroke-width="2" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" />
    <!-- 2. SURFACE ISOCURVES -->
    <g fill="none" stroke="#999999" stroke-dark="#777777" stroke-width="1" xmlns="http://www.w3.org/2000/svg">
      <!-- Left Surface Isocurves -->
      <path d="M 13,11 L 13,25" />
      <path d="M 4,21 L 22,15" />
      <!-- Right Surface Isocurves -->
      <path d="M 33,6 L 33,20" />
      <path d="M 22,15 C 30,15 38,11 44,11" />
    </g>
    <!-- 3. CONTROL POLYGON DASHED LINE (Target Surface Top Edge) -->
    <polyline points="22,8 30,8 38,4 44,4" fill="none" fill-dark="none" stroke="#888888" stroke-dark="#AAAAAA" stroke-width="2" stroke-dasharray="3,3" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" />
    <!-- 4. TANGENT & CURVATURE LINES (Crisp Edges Applied) -->
    <g shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">
      <line x1="22" y1="8" x2="30" y2="8" stroke="#333333" stroke-dark="#CCCCCC" stroke-width="2" />
      <line x1="30" y1="8" x2="38" y2="4" stroke="#666666" stroke-dark="#AAAAAA" stroke-width="2" />
    </g>
    <!-- 5. CONTROL POINTS (8x8 Outer Squares, 4x4 Solid Inner Masks) -->
    <!-- Inner masks match the UI background to block the lines behind them -->
    <g shape-rendering="crispEdges" stroke="none" stroke-dark="none" xmlns="http://www.w3.org/2000/svg">
      <!-- G0 Base Anchor (Center Top Edge: 22,8) -->
      <!-- Outer -->
      <rect x="18" y="4" width="8" height="8" fill="#000000" fill-dark="#FFFFFF" />
      <!-- Inner 4x4 Mask -->
      <rect x="20" y="6" width="4" height="4" fill="#FFFFFF" fill-dark="#323232" />
      <!-- G1 Tangent Anchor (Center: 30,8) -->
      <!-- Outer -->
      <rect x="26" y="4" width="8" height="8" fill="#333333" fill-dark="#CCCCCC" />
      <!-- Inner 4x4 Mask -->
      <rect x="28" y="6" width="4" height="4" fill="#FFFFFF" fill-dark="#323232" />
      <!-- G2 Curvature Anchor (Center: 38,4) -->
      <!-- Outer -->
      <rect x="34" y="0" width="8" height="8" fill="#666666" fill-dark="#AAAAAA" />
      <!-- Inner 4x4 Mask -->
      <rect x="36" y="2" width="4" height="4" fill="#FFFFFF" fill-dark="#323232" />
    </g>
    <!-- 6. COMMODORE PET "SPB" (Crisp Edges, Exactly 2px Bottom Padding) -->
    <g transform="translate(8, 32) scale(2)" fill="#000000" fill-dark="#FFFFFF" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">
      <!-- S -->
      <path d="M1,0 h3 v1 h-3 Z M0,1 h1 v1 h-1 Z M4,1 h1 v1 h-1 Z M0,2 h1 v1 h-1 Z M1,3 h3 v1 h-3 Z M4,4 h1 v1 h-1 Z M0,5 h1 v1 h-1 Z M4,5 h1 v1 h-1 Z M1,6 h3 v1 h-3 Z" />
      <!-- P -->
      <path d="M6,0 h4 v1 h-4 Z M6,1 h1 v1 h-1 Z M10,1 h1 v1 h-1 Z M6,2 h1 v1 h-1 Z M10,2 h1 v1 h-1 Z M6,3 h4 v1 h-4 Z M6,4 h1 v1 h-1 Z M6,5 h1 v1 h-1 Z M6,6 h1 v1 h-1 Z" />
      <!-- B -->
      <path d="M12,0 h4 v1 h-4 Z M12,1 h1 v1 h-1 Z M16,1 h1 v1 h-1 Z M12,2 h1 v1 h-1 Z M16,2 h1 v1 h-1 Z M12,3 h4 v1 h-4 Z M12,4 h1 v1 h-1 Z M16,4 h1 v1 h-1 Z M12,5 h1 v1 h-1 Z M16,5 h1 v1 h-1 Z M12,6 h4 v1 h-4 Z" />
    </g>
  </svg>
</svg></light>
