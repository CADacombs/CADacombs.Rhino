    <icon guid="5c29c283-c374-4595-8117-e9e34303837b" name="f8bc3668-4d04-4cca-acbe-9bbdf86dfd4f.svg">
      <light><svg width="48" height="48" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0pt 0pt 48pt 48pt" fill-dark="#FFF" stroke-dark="none">
  <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
    <!-- ABSOLUTE PRIMITIVES -->
    <!-- Defined by exact coordinates on the grid -->
    <rect x="2" y="2" width="8" height="8" fill="#3b82f6" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <circle cx="30" cy="6" r="4" fill="#10b981" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <ellipse cx="6" cy="18" rx="4" ry="2" fill="#f59e0b" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <line x1="26" y1="14" x2="34" y2="22" stroke="#ef4444" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <polyline points="2,26 6,34 10,26" fill="none" stroke="#6366f1" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <polygon points="26,26 34,26 30,34" fill="#ec4899" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <!-- "RELATIVE" PRIMITIVES -->
    <!-- Defined at 0,0 and pushed into position via transform -->
    <rect width="8" height="8" transform="translate(14, 2)" fill="#8b5cf6" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <circle r="4" transform="translate(42, 6)" fill="#14b8a6" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <ellipse rx="4" ry="2" transform="translate(18, 18)" fill="#f97316" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <line x1="0" y1="0" x2="8" y2="8" transform="translate(38, 14)" stroke="#be185d" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <polyline points="0,0 4,8 8,0" transform="translate(14, 26)" fill="none" stroke="#8b5cf6" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <polygon points="0,0 8,0 4,8" transform="translate(38, 26)" fill="#be185d" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <!-- PATHS (Standard Shapes) -->
    <!-- Left uses Absolute (M, L), Right uses Relative (m, l) -->
    <path d="M 2 38 L 6 46 L 10 38 Z" fill="#0ea5e9" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <path d="m 14 38 l 4 8 l 4 -8 z" fill="#38bdf8" stroke="#000000" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <!-- PATHS (Arcs) -->
    <!-- Left uses Absolute (A), Right uses Relative (a) -->
    <path d="M 26 42 A 4 4 0 0 1 34 42" fill="none" stroke="#16a34a" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
    <path d="m 38 42 a 4 4 0 0 1 8 0" fill="none" stroke="#22c55e" stroke-width="1" xmlns="http://www.w3.org/2000/svg" />
  </svg>
  <line fill-dark="#FFF" stroke="#000" stroke-dark="#000" x1="4.5" y1="12.5" x2="22.5" y2="30.5" />
</svg></light>
    </icon>
    <icon guid="40e31dd7-86b0-48aa-8e3c-966fe745c1c3" name="b91a1e3b-ed04-4f51-b4f2-828de7b882b6.svg">
      <light><svg width="48" height="48" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0pt 0pt 48pt 48pt" fill-dark="#FFF" stroke-dark="none">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 820" width="100%" height="100%" style="background-color: #f8fafc;">
    <title xmlns="http://www.w3.org/2000/svg">Complete SVG Element Test Suite</title>
    <desc xmlns="http://www.w3.org/2000/svg">A comprehensive test file containing primary visible SVG element types.</desc>
    <defs xmlns="http://www.w3.org/2000/svg">
      <!-- Gradient for fills -->
      <linearGradient id="linearGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
      </linearGradient>
      <!-- Marker for lines and paths -->
      <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#ef4444" />
      </marker>
      <!-- Pattern for fills -->
      <pattern id="dotPattern" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="10" cy="10" r="4" fill="#6366f1" />
      </pattern>
      <!-- Clip Path -->
      <clipPath id="circleClip">
        <circle cx="110" cy="60" r="45" />
      </clipPath>
    </defs>
    <!-- Main Container -->
    <g id="main-content" transform="translate(40, 40)" xmlns="http://www.w3.org/2000/svg">
      <!-- Group 1: Basic Shapes -->
      <g id="basic-shapes" transform="translate(0, 0)">
        <rect x="10" y="10" width="120" height="80" rx="15" ry="15" fill="url(#linearGrad)" stroke="#1e3a8a" stroke-width="3" />
        <text x="70" y="115" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">rect</text>
        <circle cx="230" cy="50" r="40" fill="#10b981" stroke="#047857" stroke-width="3" />
        <text x="230" y="115" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">circle</text>
        <ellipse cx="380" cy="50" rx="55" ry="35" fill="#f59e0b" stroke="#b45309" stroke-width="3" />
        <text x="380" y="115" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">ellipse</text>
        <line x1="490" y1="20" x2="590" y2="80" stroke="#ef4444" stroke-width="5" stroke-linecap="round" marker-end="url(#arrow)" />
        <text x="540" y="115" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">line &amp; marker</text>
        <polyline points="650,80 680,20 710,80 740,20" fill="none" stroke="#6366f1" stroke-width="4" stroke-linejoin="round" />
        <text x="695" y="115" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">polyline</text>
        <polygon points="830,15 880,40 860,90 800,90" fill="#ec4899" stroke="#be185d" stroke-width="3" />
        <text x="835" y="115" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">polygon</text>
      </g>
      <!-- Group 2: Advanced Vector Paths -->
      <g id="advanced-paths" transform="translate(0, 160)">
        <path d="M 10,60 C 50,10 90,110 130,60 S 210,110 250,60 A 40,40 0 0,1 330,60 L 330,100 Z" fill="url(#dotPattern)" stroke="#0ea5e9" stroke-width="4" />
        <text x="170" y="150" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">path (bezier, arc, fill pattern)</text>
      </g>
      <!-- Group 3: Text & Typography Sub-elements -->
      <g id="text-elements" transform="translate(450, 160)">
        <text x="20" y="40" font-family="sans-serif" font-size="22" fill="#0f172a">
        Standard <tspan fill="#2563eb" font-weight="bold">tspan element</tspan></text>
        <path id="textCurve" d="M 20,90 Q 150,140 300,90" fill="none" stroke="transparent" />
        <text font-family="sans-serif" font-size="16" fill="#16a34a">
          <textPath href="#textCurve">textPath element mapping along a curve</textPath>
        </text>
        <text x="160" y="150" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">text, tspan, &amp; textPath</text>
      </g>
      <!-- Group 4: Structured Links & Cloning -->
      <g id="links-and-cloning" transform="translate(0, 360)">
        <a href="https://example.com" target="_blank">
          <rect x="10" y="10" width="140" height="70" rx="8" fill="#14b8a6" />
          <text x="80" y="50" font-family="sans-serif" font-size="16" fill="#ffffff" text-anchor="middle" font-weight="bold">a (link anchor)</text>
        </a>
        <text x="80" y="110" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">a (hyperlink wrapper)</text>
        <g transform="translate(230, 0)">
          <rect id="sourceRect" x="0" y="10" width="80" height="70" fill="#a855f7" />
          <use href="#sourceRect" x="120" y="0" opacity="0.6" />
        </g>
        <text x="320" y="110" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">use (cloned graphic element)</text>
      </g>
      <!-- Group 5: Visibility Controls -->
      <g id="clipping-controls" transform="translate(0, 540)">
        <!-- Orange rectangle clipped by circle mask -->
        <g clip-path="url(#circleClip)">
          <rect x="50" y="10" width="120" height="100" fill="#ea580c" />
        </g>
        <!-- Corrected stroke reference ring tracking local coordinates -->
        <circle cx="110" cy="60" r="45" fill="none" stroke="#ea580c" stroke-width="2" stroke-dasharray="5,4" />
        <text x="110" y="135" font-family="sans-serif" font-size="14" fill="#0f172a" text-anchor="middle" font-weight="bold">clipPath container application</text>
      </g>
    </g>
  </svg>
</svg></light>
    </icon>
