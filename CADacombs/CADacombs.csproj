<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetExt>.rhp</TargetExt>
    
    <!-- Build only for .NET 8 during Debug -->
    <TargetFrameworks Condition="'$(Configuration)' == 'Debug'">net8.0</TargetFrameworks>
    <!-- Build for both .NET Framework 4.8 and .NET 8 during Release -->
    <TargetFrameworks Condition="'$(Configuration)' == 'Release'">net48;net8.0</TargetFrameworks>
    
    <AssemblyName>CADacombs</AssemblyName>
    <Title>CADacombs for Rhino</Title>
    <Version>0.2.7-alpha</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>A growing collection of tools.</Description>
    <Company>Steven P. Burzinski</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.13.*" />
    <PackageReference Include="Eto.Forms" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copies the RUI file to the build output folder so Yak packages it -->
    <None Update="CADacombs.rui;manifest.yml;icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
