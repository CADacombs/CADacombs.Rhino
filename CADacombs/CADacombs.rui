    <icon guid="d1a1b2c3-1234-4321-a1b2-c3d4e5f6a7ba" name="spb_Drape.svg">
      <light><svg width="48" height="48" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
        <!-- Target Object (Stepped Gray Body) -->
        <polygon points="12,30 12,16 24,16 24,24 36,24 36,30" fill="#E0E0E0" fill-dark="#4D4D4D" stroke="#999999" stroke-dark="#777777" stroke-width="1.5" stroke-linejoin="round"/>
