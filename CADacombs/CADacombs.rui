        <g transform="translate(8, 32) scale(2)" fill="#000000" fill-dark="#FFFFFF" shape-rendering="crispEdges">
          <!-- S -->
          <path d="M1,0 h3 v1 h-3 Z M0,1 h1 v1 h-1 Z M4,1 h1 v1 h-1 Z M0,2 h1 v1 h-1 Z M1,3 h3 v1 h-3 Z M4,4 h1 v1 h-1 Z M0,5 h1 v1 h-1 Z M4,5 h1 v1 h-1 Z M1,6 h3 v1 h-3 Z" />
