        <path d="M 4,28 C 8,28 10,16 14,16 L 24,16 C 28,16 28,24 32,24 L 36,24 C 40,24 42,28 46,28" fill="none" stroke="#000000" stroke-dark="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
