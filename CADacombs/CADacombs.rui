        <line x1="4" y1="6" x2="44" y2="6" stroke="#888888" stroke-dark="#AAAAAA" stroke-width="2" stroke-dasharray="4,2" shape-rendering="crispEdges"/>
        <!-- Vertical Z-Axis Projections (Raycasts) -->
        <g stroke="#AAAAAA" stroke-dark="#666666" stroke-width="1.5" stroke-dasharray="2,2" shape-rendering="crispEdges">
