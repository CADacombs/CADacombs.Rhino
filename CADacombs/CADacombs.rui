        <path d="M 4,4 C 20,12 28,12 44,4" fill="none" stroke="#000000" stroke-dark="#FFFFFF" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M 4,44 C 20,36 28,36 44,44" fill="none" stroke="#000000" stroke-dark="#FFFFFF" stroke-width="1.5" stroke-linecap="round"/>
