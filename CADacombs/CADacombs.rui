        <path d="M 4,4 C 20,12 28,12 44,4 C 36,20 36,28 44,44 C 28,36 20,36 4,44 C 12,28 12,20 4,4 Z" fill="#c8d5ff" fill-dark="#304ab6" stroke="none" />
        <path d="M 4,4 C 20,12 28,12 44,4 C 36,20 36,28 44,44 C 28,36 20,36 4,44 C 12,28 12,20 4,4 Z" fill="url(#surfHighlight)" stroke="none"/>
