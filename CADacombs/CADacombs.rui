    </icon>

    <!-- 6. ccEndBulge Icon (Smooth NURBS curve with control polygon) -->
    <icon guid="2f15babb-70f3-4ff0-a57e-bb47a54057b3" name="2f15babb-70f3-4ff0-a57e-bb47a54057b3.svg">
      <light><svg width="48" height="48" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
        <!-- Curve -->
