        <path d="M 44,4 C 36,20 36,28 44,44" fill="none" stroke="#000000" stroke-dark="#FFFFFF" stroke-width="1.5" stroke-linecap="round"/>
      </svg></light>
    </icon>

    <!-- 4. ccDrape Icon (Target object, Raycasts, Drape surface) -->
    <icon guid="d1a1b2c3-1234-4321-a1b2-c3d4e5f6a7ba" name="ccDrape.svg">
      <light><svg width="48" height="48" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
        <defs>
          <linearGradient id="surfHighlight" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.7" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </linearGradient>
        </defs>
        <!-- Target Object -->
        <path d="M 12,44 L 12,24 L 24,24 L 24,32 L 36,32 L 36,44 Z" fill="#DDDDDD" fill-dark="#555555" stroke="#000000" stroke-dark="#FFFFFF" stroke-width="1.5" stroke-linejoin="round"/>
        <!-- Drape Surface -->
        <path d="M 4,40 C 8,40 10,20 16,20 C 22,20 22,28 28,28 C 34,28 38,40 44,40 C 44,44 4,44 4,40 Z" fill="#c8d5ff" fill-dark="#304ab6" stroke="#000000" stroke-dark="#FFFFFF" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M 4,40 C 8,40 10,20 16,20 C 22,20 22,28 28,28 C 34,28 38,40 44,40 C 44,44 4,44 4,40 Z" fill="url(#surfHighlight)" stroke="none"/>
        <!-- Raycasts (Dashed lines + arrows) -->
        <line x1="4" y1="8" x2="44" y2="8" stroke="#888888" stroke-dark="#AAAAAA" stroke-width="2" stroke-dasharray="4,2"/>
        <path d="M 16,8 L 16,16 M 14,14 L 16,18 L 18,14" fill="none" stroke="#888888" stroke-dark="#AAAAAA" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M 28,8 L 28,24 M 26,22 L 28,26 L 30,22" fill="none" stroke="#888888" stroke-dark="#AAAAAA" stroke-width="1.5" stroke-linejoin="round"/>
      </svg></light>
    </icon>

    <!-- 5. ccMatchSrf Icon (2 Surfaces, tangent lines) -->
    <icon guid="d2c12ed9-9585-4f85-9662-fb0ff32d9bbb" name="d2c12ed9-9585-4f85-9662-fb0ff32d9bbb.svg">
      <light><svg width="48" height="48" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
        <defs>
          <linearGradient id="surfHighlight" x1="0" y1="0" x2="1" y2="1">
